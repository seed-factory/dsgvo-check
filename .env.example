# dsgvo-check settings. Every line is optional: the values shown are the built-in defaults, and a scan
# without any of them runs with exactly these values.
#
# Precedence: command-line flag > environment variable > this file (.env in the current directory) >
# built-in default. A variable that is already set in the environment wins over this file.
# Numbers carry their unit in the name (_MS milliseconds, _BYTES bytes, _DAYS days). An empty value counts
# as unset. Values are read as they stand: no quotes needed, lists are comma-separated.
#
# Generated from src/core/config by `corepack pnpm env:example`; do not edit by hand.

# ---- scan: limits of one run

# Severity from which the exit code is 1 (CLI: --fail-on). One of: critical, warning, none.
# DSGVO_CHECK_SCAN_FAIL_ON=critical

# Pages the browser visits in phase A, start page included (CLI: --max-pages). Range: 1..50.
# DSGVO_CHECK_SCAN_MAX_PAGES=6

# Global time limit of one scan (CLI: --timeout, which also accepts 8m or 90s). Minimum: 1.
# DSGVO_CHECK_SCAN_TIMEOUT_MS=480000

# HTTP proxy for browser, HTTP and TLS probes (CLI: --proxy). May hold credentials: keep it out of
# the process list.
# DSGVO_CHECK_PROXY=

# Time a collector gets after the global timeout to stop and hand over what it has. Must exceed the
# 5.5 s orderly browser shutdown. Minimum: 6000.
# DSGVO_CHECK_SCAN_ABORT_GRACE_MS=10000

# Reserve on top of the global timeout for writing reports; the watchdog ends the process after
# timeout plus reserve. Must cover DSGVO_CHECK_SCAN_ABORT_GRACE_MS plus DSGVO_CHECK_PDF_TIMEOUT_MS.
# Minimum: 1.
# DSGVO_CHECK_SCAN_REPORT_WRITE_RESERVE_MS=30000

# ---- browser: Chromium, pauses, timeouts, recording limits

# Chromium sandbox: require, off for hosts without user namespaces, or container (only inside the
# dsgvo-check image, where the container is the isolation; CLI: --sandbox). One of: require, off,
# container.
# DSGVO_CHECK_BROWSER_SANDBOX=require

# Time limit for starting Chromium. Minimum: 1000.
# DSGVO_CHECK_BROWSER_LAUNCH_TIMEOUT_MS=60000

# Pause between two navigations of the browser. Minimum: 1500.
# DSGVO_CHECK_BROWSER_NAVIGATION_PAUSE_MS=1500

# Time limit of one navigation until the document is committed. Minimum: 1000.
# DSGVO_CHECK_BROWSER_NAVIGATION_TIMEOUT_MS=30000

# Time limit for the load event after a navigation. Minimum: 1000.
# DSGVO_CHECK_BROWSER_LOAD_TIMEOUT_MS=15000

# Pause before the single retry after a 5xx or 429 of the start page (a Retry-After header wins,
# capped at 30 s). Minimum: 3000.
# DSGVO_CHECK_BROWSER_RETRY_DELAY_MS=3000

# Time kept free before the global timeout: no new page is started once less is left. Minimum: 0.
# DSGVO_CHECK_BROWSER_DEADLINE_RESERVE_MS=20000

# Time limit of one call into the CMP subsystem (detect, extract, click). Minimum: 1000.
# DSGVO_CHECK_BROWSER_CMP_CALL_TIMEOUT_MS=15000

# A page counts as quiet after this long without a new request. Minimum: 0.
# DSGVO_CHECK_BROWSER_QUIET_WINDOW_MS=2000

# Requests that may stay open while a page still counts as quiet. Range: 0..100.
# DSGVO_CHECK_BROWSER_MAX_INFLIGHT=1

# Phase A: shortest stay on a page before it can count as quiet. Minimum: 0.
# DSGVO_CHECK_BROWSER_PHASE_A_MIN_DWELL_MS=6000

# Phase A: longest stay on a page; quiet not reached is recorded. Minimum: 0.
# DSGVO_CHECK_BROWSER_PHASE_A_HARD_CAP_MS=20000

# Phase B (reject): shortest stay on a page before it can count as quiet. Minimum: 0.
# DSGVO_CHECK_BROWSER_PHASE_B_MIN_DWELL_MS=4000

# Phase B (reject): longest stay on a page; quiet not reached is recorded. Minimum: 0.
# DSGVO_CHECK_BROWSER_PHASE_B_HARD_CAP_MS=12000

# Phase C (accept): shortest stay on a page before it can count as quiet. Minimum: 0.
# DSGVO_CHECK_BROWSER_PHASE_C_MIN_DWELL_MS=4000

# Phase C (accept): longest stay on a page; quiet not reached is recorded. Minimum: 0.
# DSGVO_CHECK_BROWSER_PHASE_C_HARD_CAP_MS=12000

# Requests recorded per scan; further ones are only counted. Range: 100..100000.
# DSGVO_CHECK_BROWSER_REQUEST_LIMIT=2000

# Largest banner screenshot kept. The HTML report embeds images up to
# DSGVO_CHECK_REPORT_SCREENSHOT_EMBED_MAX_BYTES. Range: 10240..2097152.
# DSGVO_CHECK_BROWSER_SCREENSHOT_MAX_BYTES=204800

# Largest share of the viewport a banner may cover to be photographed; a larger container gets no
# image. Above 0, at most 1.
# DSGVO_CHECK_BROWSER_SCREENSHOT_MAX_VIEWPORT_SHARE=0.5

# Time limit for fetching robots.txt and sitemaps. Minimum: 1000.
# DSGVO_CHECK_BROWSER_SOURCE_FETCH_TIMEOUT_MS=8000

# Time limit per response for reading its headers and server address. Minimum: 100.
# DSGVO_CHECK_BROWSER_RESPONSE_META_TIMEOUT_MS=5000

# Time limit per frame for reading cookies and Web Storage names. Minimum: 100.
# DSGVO_CHECK_BROWSER_STORAGE_READ_TIMEOUT_MS=1000

# ---- http: passive HTTP probes

# Smallest gap between two requests to one host, for the HTTP probes and robots.txt and sitemaps
# (500 = 2 requests per second). Minimum: 500.
# DSGVO_CHECK_HTTP_MIN_INTERVAL_MS=500

# Time limit for connecting to a host. Minimum: 100.
# DSGVO_CHECK_HTTP_CONNECT_TIMEOUT_MS=5000

# Time limit until the response headers arrive. Minimum: 100.
# DSGVO_CHECK_HTTP_HEADERS_TIMEOUT_MS=10000

# Time limit between two chunks of a response body. Minimum: 100.
# DSGVO_CHECK_HTTP_BODY_TIMEOUT_MS=10000

# Time limit of one request from start to the end of the body. Minimum: 100.
# DSGVO_CHECK_HTTP_REQUEST_TIMEOUT_MS=20000

# Redirect hops followed per probe chain. Range: 1..20.
# DSGVO_CHECK_HTTP_MAX_REDIRECTS=5

# ---- tls: handshakes and certificate windows (TLS-02)

# Time limit of one TLS handshake. Minimum: 100.
# DSGVO_CHECK_TLS_TIMEOUT_MS=10000

# Certificates valid for at most this many days are short-lived and never reported as expiring.
# Minimum: 0.
# DSGVO_CHECK_TLS_SHORT_LIVED_DAYS=10

# TLS-02 expiring: reported when fewer days are left than this and less than
# DSGVO_CHECK_TLS_EXPIRING_LIFETIME_SHARE of the lifetime. Minimum: 0.
# DSGVO_CHECK_TLS_EXPIRING_DAYS=14

# TLS-02 expiring: share of the certificate lifetime; it keeps short-lived certificates from being
# reported too early. Above 0, at most 1.
# DSGVO_CHECK_TLS_EXPIRING_LIFETIME_SHARE=0.25

# TLS-02 expiry approaching: reported when fewer days are left than this and less than
# DSGVO_CHECK_TLS_APPROACHING_LIFETIME_SHARE of the lifetime. Minimum: 0.
# DSGVO_CHECK_TLS_APPROACHING_DAYS=30

# TLS-02 expiry approaching: share of the certificate lifetime, as for the expiring window. Above 0,
# at most 1.
# DSGVO_CHECK_TLS_APPROACHING_LIFETIME_SHARE=0.5

# ---- dns: mail DNS lookups (MAIL-01, MAIL-02)

# Resolvers as comma-separated host or host:port; empty uses the system resolver.
# DSGVO_CHECK_DNS_SERVERS=

# Time limit of one DNS attempt. Minimum: 100.
# DSGVO_CHECK_DNS_TIMEOUT_MS=3000

# Further attempts after SERVFAIL or a timeout. Range: 0..5.
# DSGVO_CHECK_DNS_RETRIES=1

# DNS queries per scan. Range: 1..200.
# DSGVO_CHECK_DNS_QUERY_BUDGET=60

# DNS queries in flight at once. Range: 1..16.
# DSGVO_CHECK_DNS_CONCURRENCY=4

# Queries that end in a timeout (after retries) before the resolver counts as unresponsive and the
# rest is skipped. Range: 1..20.
# DSGVO_CHECK_DNS_MAX_TIMEOUT_RESULTS=3

# ---- cmp: cookie banner recognition (CONSENT-04)

# Share of the viewport a banner must cover to count as blocking, besides overlay, scroll lock and
# inert content. Above 0, at most 1.
# DSGVO_CHECK_CMP_BLOCKING_COVERED_RATIO=0.85

# Time to wait for a CMP and its banner to appear (capped by
# DSGVO_CHECK_BROWSER_CMP_CALL_TIMEOUT_MS). Minimum: 0.
# DSGVO_CHECK_CMP_WAIT_MS=5000

# ---- report: output and size limits

# Report formats, comma-separated: console, json, html, summary, pdf (CLI: --format, also of the
# report command, which writes html while this is not set).
# DSGVO_CHECK_REPORT_FORMATS=console,json

# Directory for reports and artifacts (CLI: --out).
# DSGVO_CHECK_REPORT_OUT_DIR=./dsgvo-check-report

# Language of the report texts (CLI: --lang, also of the report command). One of: de, en.
# DSGVO_CHECK_REPORT_LANG=de

# Findings listed in summary.md (the Job Summary); more are counted. Range: 1..1000.
# DSGVO_CHECK_REPORT_SUMMARY_MAX_FINDINGS=50

# Size above which summary.md is cut. Range: 10240..5242880.
# DSGVO_CHECK_REPORT_SUMMARY_MAX_BYTES=524288

# Largest screenshot embedded into report.html. Range: 1024..16777216.
# DSGVO_CHECK_REPORT_SCREENSHOT_EMBED_MAX_BYTES=2097152

# Evidence items kept per finding; more are marked as truncated. Range: 1..200.
# DSGVO_CHECK_REPORT_MAX_EVIDENCE_PER_FINDING=20

# ---- pdf: PDF printing

# Time limit for printing report.pdf; a longer print is dropped with a warning. Minimum: 1000.
# DSGVO_CHECK_PDF_TIMEOUT_MS=15000

# ---- tests: development only, read by vitest.config.ts and not by the scanner

# Test files run in parallel (Vitest workers): a whole number or a share of the logical cores, for
# example 4 or 50%. Empty: one worker per logical core. CI sets 4, the reference runner (4 vCPU,
# 16 GB); the repository variable DSGVO_TEST_WORKERS overrides it there.
# DSGVO_TEST_WORKERS=
